# Public/build configuration (not secrets)
AWS_REGION=example-region-1
AWS_ACCOUNT_ID=000000000000
BACKEND_ECR_REPOSITORY=talensora-staging-backend
FRONTEND_ECR_REPOSITORY=talensora-staging-frontend
BACKEND_IMAGE=000000000000.dkr.ecr.example-region-1.amazonaws.com/talensora-staging-backend:git-sha
FRONTEND_IMAGE=000000000000.dkr.ecr.example-region-1.amazonaws.com/talensora-staging-frontend:git-sha
SPRING_PROFILES_ACTIVE=staging
STAGING_APP_HOST=staging.example.com
STAGING_KEYCLOAK_HOST=id-staging.example.com
STAGING_APP_URL=https://staging.example.com
STAGING_KEYCLOAK_URL=https://id-staging.example.com
VITE_KEYCLOAK_URL=https://id-staging.example.com
VITE_KEYCLOAK_REALM=talensora
VITE_KEYCLOAK_CLIENT_ID=talensora-web
TLS_CERT_DIRECTORY=/etc/letsencrypt/live/staging
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
APPLICATION_LOG_GROUP=/talensora-staging/application
NGINX_LOG_GROUP=/talensora-staging/nginx
KEYCLOAK_LOG_GROUP=/talensora-staging/keycloak

# Application/RDS/S3/SES (replace secret placeholders only in SSM/runtime env)
DB_URL=jdbc:postgresql://private-rds.example:5432/talensora_candidate_db
DB_HOST=private-rds.example
DB_NAME=talensora_candidate_db
DB_USERNAME=talensora_app
DB_PASSWORD=change-me
KEYCLOAK_ISSUER_URI=https://id-staging.example.com/realms/talensora
RESUME_STORAGE_TYPE=s3
RESUME_S3_BUCKET=example-private-resume-bucket
RESUME_S3_PREFIX=talensora/resumes
SMTP_HOST=email-smtp.example-region-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=no-reply@example.com
ADMIN_NOTIFICATION_EMAIL=recruiting@example.com

# Keycloak production settings
KC_HOSTNAME=https://id-staging.example.com
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://private-rds.example:5432/keycloak
KC_DB_USERNAME=keycloak_app
KC_DB_PASSWORD=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=staging-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
GOOGLE_CLIENT_ID=public-client-id-placeholder
GOOGLE_CLIENT_SECRET=change-me
