aws_region       = "ap-south-1"
environment      = "staging"
domain_name      = "staging.example.com"
github_repository = "example-owner/talensora-candidate-sourcing-system"
ami_id            = "ami-placeholder"

# Tune only after checking current regional pricing and capacity.
ec2_instance_type = "t3.small"
rds_instance_class = "db.t4g.micro"
